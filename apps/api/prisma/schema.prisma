model SubscriberEducation {
  subscriberEducationID        BigInt                             @id @default(autoincrement()) @map("SubscriberEducationID")
  subscriberID                 BigInt                             @map("SubscriberID")  // FK -> SubscriberRegistration (confirmed)
  /// Despite the column name this is a COURSE id, not a course-type id: spSubscriberCVGetDetails
  /// joins `tblMstrCourse AS b ON a.CourseTypeID = b.DegreeID`, and spSubscriberCVUpdate_Education
  /// writes it from a variable named @CoureID. The extraction's guess of MstrCourseType was
  /// flagged "dirty" and is wrong — that table has no rows and no dumped source, so honouring it
  /// made every Course selection fail the foreign key.
  courseTypeID                 Int?                               @map("CourseTypeID")  // FK -> MstrCourse (confirmed via procs)
  /// The education LEVEL, not a course. candidate-profile.aspx binds this dropdown from
  /// tblMstrEducationType (fnBindDegreeDropdown reads EducationTypeID/Descr) and writes the
  /// chosen EducationTypeID straight into this column. The extraction guessed
  /// MstrEducationDegree — a byte-identical copy of MstrCourse — and flagged it "dirty".
  degreeID                     Int?                               @map("DegreeID")  // FK -> MstrEducationType (confirmed via candidate-profile.aspx)
  /// The legacy table recorded only "which course at which level", so the profile page had
  /// nothing to print under a degree — no board/university, no year. It derived the year from
  /// TimestampIns, i.e. when the row was typed in, which is not when the candidate graduated.
  instituteName                String? @db.VarChar(500)           @map("InstituteName")
  passingYear                  Int?                               @map("PassingYear")
  /// Full Time / Part Time / Correspondence — how the course was studied, free text against a
  /// fixed UI list rather than a master table, because no such master exists in the schema.
  courseMode                   String? @db.VarChar(50)            @map("CourseMode")
  marks                        String? @db.VarChar(100)           @map("Marks")
  timestampIns                 DateTime @db.Timestamp(6)          @map("TimestampIns")
  timestampUpd                 DateTime? @db.Timestamp(6)         @map("TimestampUpd")
  loginIDIns                   BigInt                             @map("LoginIDIns")
  loginIDUpd                   BigInt?                            @map("loginIDUpd")

  course                       MstrCourse?                        @relation("SubscriberEducationToMstrCourse", fields: [courseTypeID], references: [degreeID])
  degree                       MstrEducationType?                 @relation("SubscriberEducationToMstrEducationType", fields: [degreeID], references: [educationTypeID])
  subscriber                   SubscriberRegistration             @relation("SubscriberEducationToSubscriberRegistration", fields: [subscriberID], references: [subscriberID])
  @@index([subscriberID])
  @@map("tblSubscriberEducation")
}

