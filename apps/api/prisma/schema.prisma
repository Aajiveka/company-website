  statusHistoryID              BigInt                             @id @default(autoincrement()) @map("StatusHistoryID")
  subscriberID                 BigInt?                            @map("SubscriberID")  // FK -> SubscriberRegistration (dirty)
  jobID                        BigInt?                            @map("JobID")  // FK -> ClientJobs (confirmed)
  clientID                     BigInt?                            @map("ClientID")  // FK -> ClientMstr (confirmed)
  jobSubscriberMapID           BigInt?                            @map("JobSubscriberMapID")
  statusID                     Int?                               @map("StatusID")  // FK -> MstrStatus (confirmed)
  userID                       BigInt?                            @map("UserID")  // FK -> SecUser (dirty)
  comments                     String? @db.VarChar(5000)          @map("comments")
  timestampIns                 DateTime? @db.Timestamp(6)         @map("TimestampIns")
  loginIDIns                   BigInt?                            @map("LoginIDIns")

  client                       ClientMstr?                        @relation("SubscriberStatusHistoryToClientMstr", fields: [clientID], references: [clientID])
  job                          ClientJobs?                        @relation("SubscriberStatusHistoryToClientJobs", fields: [jobID], references: [jobID])
  status                       MstrStatus?                        @relation("SubscriberStatusHistoryToMstrStatus", fields: [statusID], references: [statusID])
  subscriber                   SubscriberRegistration?            @relation("SubscriberStatusHistoryToSubscriberRegistration", fields: [subscriberID], references: [subscriberID])
  user                         SecUser?                           @relation("SubscriberStatusHistoryToSecUser", fields: [userID], references: [userID])
  @@index([subscriberID])
  @@map("tblSubscriberStatusHistory")
}

model SubscriberTags {
  subscriberID                 BigInt                             @map("SubscriberID")  // FK -> SubscriberRegistration (confirmed)
  tagID                        BigInt                             @map("TagID")  // FK -> MstrTags (confirmed)

  subscriber                   SubscriberRegistration             @relation("SubscriberTagsToSubscriberRegistration", fields: [subscriberID], references: [subscriberID])
  tag                          MstrTags                           @relation("SubscriberTagsToMstrTags", fields: [tagID], references: [tagID])

  @@id([subscriberID, tagID])
  @@map("tblSubscriberTags")
}

/* ------------------------------------------------------------------------- *
 * Profile sections the legacy CV had no room for.
 *
 * tblSubscriberCVDetails is a flat, id-heavy row inherited from the ASP.NET app: it covers
 * who the candidate is and one primary skill/function, and nothing else. Everything below —
 * the headline, the summary, what they want next, how they present themselves — lived only
 * on paper in the uploaded resume, so none of it was searchable or editable in the product.
 * These live in their own tables rather than as more columns on tblSubscriberCVDetails so a
 * legacy row stays exactly as migrated until the candidate fills a section in.
 * ------------------------------------------------------------------------- */

/// One row per candidate, holding every single-valued section: headline, summary, career
/// preferences, the personal facts that are not already on tblSubscriberCVDetails, and the
/// diversity block. Split off as 1:1 rather than merged into the CV row because it is written
/// by a different set of screens and is absent for every migrated candidate.
model SubscriberProfileExtra {
  subscriberID                 BigInt                             @id @map("SubscriberID")

  /// The one-line pitch shown under the name. Naukri calls this the resume headline.
  resumeHeadline               String? @db.VarChar(500)           @map("ResumeHeadline")
  profileSummary               String? @db.VarChar(4000)          @map("ProfileSummary")

  // ── Career profile ──
  /// Free text against fixed UI lists. tblMstrSubFunctions covers function/designation, but
  /// department, role category and job role have no masters in this schema.
  department                   String? @db.VarChar(200)           @map("Department")
  roleCategory                 String? @db.VarChar(200)           @map("RoleCategory")
  jobRole                      String? @db.VarChar(200)           @map("JobRole")
  /// Comma-separated: a candidate can be open to both Permanent and Contractual.
  desiredJobType               String? @db.VarChar(100)           @map("DesiredJobType")
  desiredEmploymentType        String? @db.VarChar(100)           @map("DesiredEmploymentType")
  preferredShift               String? @db.VarChar(50)            @map("PreferredShift")
  preferredSalary              Decimal? @db.Decimal(18, 0)        @map("PreferredSalary")
  /// Comma-separated role names. Preferred *locations* are not here — they already have their
  /// own table, tblSubscriberPrefferedLocations.
  preferredJobRoles            String? @db.VarChar(1000)          @map("PreferredJobRoles")

  // ── Personal details ──
  maritalStatus                String? @db.VarChar(50)            @map("MaritalStatus")
  /// Extra personal facts the profile shows next to marital status (e.g. "Single parent").
  personalTraits               String? @db.VarChar(500)           @map("PersonalTraits")
  category                     String? @db.VarChar(50)            @map("Category")
  /// Comma-separated country names the candidate holds a work permit for.
  workPermitCountries          String? @db.VarChar(500)           @map("WorkPermitCountries")
  usWorkPermit                 String? @db.VarChar(100)           @map("USWorkPermit")

  // ── Diversity & inclusion ──
  disabilityStatus             String? @db.VarChar(100)           @map("DisabilityStatus")
  disabilityType               String? @db.VarChar(200)           @map("DisabilityType")
  /// Percent disability, as declared. Nullable and unvalidated: it is self-reported.
  disabilityPercent            Int? @db.SmallInt                  @map("DisabilityPercent")
  assistanceRequired           String? @db.VarChar(500)           @map("AssistanceRequired")
  militaryStatus               String? @db.VarChar(100)           @map("MilitaryStatus")
  militaryServiceType          String? @db.VarChar(200)           @map("MilitaryServiceType")
  militaryRank                 String? @db.VarChar(200)           @map("MilitaryRank")
  militaryEnrolmentDate        DateTime? @db.Date                 @map("MilitaryEnrolmentDate")
  careerBreakStatus            String? @db.VarChar(100)           @map("CareerBreakStatus")
  careerBreakReason            String? @db.VarChar(200)           @map("CareerBreakReason")
  careerBreakFrom              DateTime? @db.Date                 @map("CareerBreakFrom")
  /// NULL while the break is ongoing — the UI prints "Present".
  careerBreakTo                DateTime? @db.Date                 @map("CareerBreakTo")

  timestampIns                 DateTime @db.Timestamp(6)          @default(now()) @map("TimestampIns")
  timestampUpd                 DateTime? @db.Timestamp(6)         @map("TimestampUpd")
  loginIDIns                   BigInt                             @map("LoginIDIns")
  loginIDUpd                   BigInt?                            @map("loginIDUpd")

  subscriber                   SubscriberRegistration             @relation("SubscriberProfileExtraToSubscriberRegistration", fields: [subscriberID], references: [subscriberID])
  @@map("tblSubscriberProfileExtra")
}

/// Technical skills with depth — version, when it was last used, how long it was used for.
/// Distinct from tblSubscriberTags (flat keyword chips) and tblSubscriberCVDetails.SkillID
/// (the single primary skill used for matching).
model SubscriberITSkill {
  subscriberITSkillID          BigInt                             @id @default(autoincrement()) @map("SubscriberITSkillID")
  subscriberID                 BigInt                             @map("SubscriberID")
  skillName                    String @db.VarChar(200)            @map("SkillName")
  version                      String? @db.VarChar(50)            @map("Version")
  lastUsedYear                 Int?                               @map("LastUsedYear")
  expYears                     Int? @db.SmallInt                  @map("ExpYears")
  expMonths                    Int? @db.SmallInt                  @map("ExpMonths")
  timestampIns                 DateTime @db.Timestamp(6)          @default(now()) @map("TimestampIns")
  timestampUpd                 DateTime? @db.Timestamp(6)         @map("TimestampUpd")
  loginIDIns                   BigInt                             @map("LoginIDIns")
  loginIDUpd                   BigInt?                            @map("loginIDUpd")

  subscriber                   SubscriberRegistration             @relation("SubscriberITSkillToSubscriberRegistration", fields: [subscriberID], references: [subscriberID])
  @@index([subscriberID])
  @@map("tblSubscriberITSkill")
}

/// Projects worked on. Deliberately not folded into tblSubscriberEmployer: a project can be
/// personal, span two employers, or still be in progress while the job it started under ended.
model SubscriberProject {
  subscriberProjectID          BigInt                             @id @default(autoincrement()) @map("SubscriberProjectID")
  subscriberID                 BigInt                             @map("SubscriberID")
  title                        String @db.VarChar(500)            @map("Title")
  clientName                   String? @db.VarChar(500)           @map("ClientName")
  /// "In Progress" or "Finished". Drives whether WorkedTill* is shown at all.
  projectStatus                String? @db.VarChar(50)            @map("ProjectStatus")
  /// Month/year pairs rather than dates: the UI collects only those, and a synthesised
  /// day-of-month would read as precision the candidate never supplied.
  workedFromMonth              Int? @db.SmallInt                  @map("WorkedFromMonth")
  workedFromYear               Int?                               @map("WorkedFromYear")
  workedTillMonth              Int? @db.SmallInt                  @map("WorkedTillMonth")
  workedTillYear               Int?                               @map("WorkedTillYear")
  /// Onsite / Offsite.
  projectSite                  String? @db.VarChar(50)            @map("ProjectSite")
  natureOfEmployment           String? @db.VarChar(100)           @map("NatureOfEmployment")
  teamSize                     Int?                               @map("TeamSize")
  roleDescr                    String? @db.VarChar(500)           @map("RoleDescr")
  skillsUsed                   String? @db.VarChar(1000)          @map("SkillsUsed")
  details                      String? @db.VarChar(4000)          @map("Details")
  timestampIns                 DateTime @db.Timestamp(6)          @default(now()) @map("TimestampIns")
  timestampUpd                 DateTime? @db.Timestamp(6)         @map("TimestampUpd")
  loginIDIns                   BigInt                             @map("LoginIDIns")
  loginIDUpd                   BigInt?                            @map("loginIDUpd")

  subscriber                   SubscriberRegistration             @relation("SubscriberProjectToSubscriberRegistration", fields: [subscriberID], references: [subscriberID])
  @@index([subscriberID])
  @@map("tblSubscriberProject")
}

/// Online profiles, work samples, publications, presentations and patents. One table with a
/// Kind discriminator rather than five near-identical tables — every kind is (title, link,
/// description, date) and they are always read together as one "Accomplishments" block.
/// Certifications stay in tblSubscriberCertificate, which already existed.
model SubscriberAccomplishment {
  subscriberAccomplishmentID   BigInt                             @id @default(autoincrement()) @map("SubscriberAccomplishmentID")
  subscriberID                 BigInt                             @map("SubscriberID")
  /// ONLINE_PROFILE | WORK_SAMPLE | PUBLICATION | PRESENTATION | PATENT
  kind                         String @db.VarChar(30)             @map("Kind")
  title                        String @db.VarChar(500)            @map("Title")
  url                          String? @db.VarChar(2000)          @map("Url")
  descr                        String? @db.VarChar(4000)          @map("Descr")
  /// Publication/presentation date, or the patent filing date.
  eventMonth                   Int? @db.SmallInt                  @map("EventMonth")
  eventYear                    Int?                               @map("EventYear")
  /// Patents only: "Filed" vs "Granted", and the office/application number.
  patentStatus                 String? @db.VarChar(50)            @map("PatentStatus")
  patentOffice                 String? @db.VarChar(200)           @map("PatentOffice")
  timestampIns                 DateTime @db.Timestamp(6)          @default(now()) @map("TimestampIns")
  timestampUpd                 DateTime? @db.Timestamp(6)         @map("TimestampUpd")
  loginIDIns                   BigInt                             @map("LoginIDIns")
  loginIDUpd                   BigInt?                            @map("loginIDUpd")

  subscriber                   SubscriberRegistration             @relation("SubscriberAccomplishmentToSubscriberRegistration", fields: [subscriberID], references: [subscriberID])
  @@index([subscriberID, kind])
  @@map("tblSubscriberAccomplishment")
}


/// Job alerts have NO legacy equivalent — no such table exists anywhere in db_aajiveka.bak.
/// The feature lived only in the MSW mocks, so this is a genuinely new table, not a port.
model SubscriberJobAlert {
  alertID                      BigInt                             @id @default(autoincrement()) @map("AlertID")
  subscriberID                 BigInt                             @map("SubscriberID")
  keyword                      String @db.VarChar(200)            @map("Keyword")
  location                     String @db.VarChar(200)            @map("Location")
  frequency                    String @db.VarChar(10)             @map("Frequency")
  timestampIns                 DateTime @db.Timestamp(6)          @default(now()) @map("TimestampIns")

  subscriber                   SubscriberRegistration             @relation("SubscriberJobAlertToSubscriberRegistration", fields: [subscriberID], references: [subscriberID])

  @@index([subscriberID])
  @@map("tblSubscriberJobAlert")
}

/// Saved / bookmarked jobs — candidates can save jobs for later without applying.
model SavedJob {
  savedJobID                   BigInt                             @id @default(autoincrement()) @map("SavedJobID")
  subscriberID                 BigInt                             @map("SubscriberID")
  jobID                        BigInt                             @map("JobID")
  timestampIns                 DateTime @db.Timestamp(6)          @default(now()) @map("TimestampIns")

  subscriber                   SubscriberRegistration             @relation("SavedJobToSubscriberRegistration", fields: [subscriberID], references: [subscriberID])
  job                          ClientJobs                         @relation("SavedJobToClientJobs", fields: [jobID], references: [jobID])

  @@unique([subscriberID, jobID])
  @@index([subscriberID])
  @@map("tblSavedJob")
}

/// Password-reset tokens. tblForgotPassword EXISTS in the legacy DB but is useless — it is
/// only (forgotPasswordID, USERID, TimestampIns), with no token, no expiry and no used
/// flag, so it cannot back a reset flow. (The old inferred SCHEMA_REPORT claimed it had
/// EmailId/Token/ExpiryDate/IsUsed; the real catalog says otherwise.) This is new.
model AuthPasswordReset {
  resetID                      BigInt                             @id @default(autoincrement()) @map("ResetID")
  userID                       BigInt                             @map("UserID")
  /// SHA-256 of the token. The plaintext only ever exists in the email — a database leak
  /// must not hand over working reset links.
  tokenHash                    String @db.VarChar(64)             @unique @map("TokenHash")
  expiresAt                    DateTime @db.Timestamp(6)          @map("ExpiresAt")
  usedAt                       DateTime? @db.Timestamp(6)         @map("UsedAt")
  timestampIns                 DateTime @db.Timestamp(6)          @default(now()) @map("TimestampIns")

  user                         SecUser                            @relation("AuthPasswordResetToSecUser", fields: [userID], references: [userID])

  @@index([userID])
  @@map("tblAuthPasswordReset")
}

/// Audit trail. The legacy app had none — there is no such table in the backup, and the
/// 97 procs write no history beyond tblSubscriberStatusHistory (which is domain state, not
/// an audit log).
model AuditLog {
  auditID                      BigInt                             @id @default(autoincrement()) @map("AuditID")
  userID                       BigInt?                            @map("UserID")
  action                       String @db.VarChar(60)             @map("Action")
  entity                       String? @db.VarChar(60)            @map("Entity")
  entityID                     String? @db.VarChar(60)            @map("EntityID")
  ipAddress                    String? @db.VarChar(45)            @map("IPAddress")
  userAgent                    String? @db.VarChar(300)           @map("UserAgent")
  detail                       String? @db.Text                   @map("Detail")
  timestampIns                 DateTime @db.Timestamp(6)          @default(now()) @map("TimestampIns")

  @@index([userID])
  @@index([timestampIns])
  @@map("tblAuditLog")
}

/// Subscription plans. ALL NEW — the legacy database has no payment, order or subscription
/// table anywhere; the prices lived only in Pricing.aspx markup. Putting them in the
/// database means an order references a plan and the amount is never taken from the client.
model SubscriptionPlan {
  planID                       Int                                @id @default(autoincrement()) @map("PlanID")
  /// entry | mid | senior — the experience tier from Pricing.aspx.
  tier                         String @db.VarChar(20)             @map("Tier")
  tierLabel                    String @db.VarChar(60)             @map("TierLabel")
  months                       Int                                @map("Months")
  /// Whole rupees. Money is never a float.
  priceInr                     Int                                @map("PriceINR")
  active                       Boolean                            @default(true) @map("Active")

  orders                       PaymentOrder[]                     @relation("PaymentOrderToSubscriptionPlan")
  subscriptions                Subscription[]                     @relation("SubscriptionToSubscriptionPlan")

  @@unique([tier, months])
  @@map("tblSubscriptionPlan")
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  ABORTED
}

/// One row per attempt to pay. Append-only in spirit: the raw BillDesk response is kept so
/// a disputed transaction can be reconstructed.
model PaymentOrder {
  orderID                      BigInt                             @id @default(autoincrement()) @map("OrderID")
  /// Our reference, sent to BillDesk as orderid. Unique and unguessable.
  orderRef                     String @db.VarChar(40)             @unique @map("OrderRef")
  subscriberID                 BigInt                             @map("SubscriberID")
  planID                       Int                                @map("PlanID")
  /// Copied from the plan at creation time, so a later price change cannot alter a past order.
  amountInr                    Int                                @map("AmountINR")
  status                       PaymentStatus                      @default(CREATED) @map("Status")

  /// BillDesk's own order id, returned by the create-order call.
  bdOrderId                    String? @db.VarChar(60)            @map("BDOrderID")
  /// The transaction id on the settled payment.
  transactionId                String? @db.VarChar(60)            @unique @map("TransactionID")
  authStatus                   String? @db.VarChar(10)            @map("AuthStatus")
  paymentMethod                String? @db.VarChar(40)            @map("PaymentMethod")
  errorDescription             String? @db.VarChar(300)           @map("ErrorDescription")
  /// The verified JWS payload, as received. Kept for dispute resolution.
  rawResponse                  String? @db.Text                   @map("RawResponse")

  createdAt                    DateTime @db.Timestamp(6)          @default(now()) @map("CreatedAt")
  settledAt                    DateTime? @db.Timestamp(6)         @map("SettledAt")

  subscriber                   SubscriberRegistration             @relation("PaymentOrderToSubscriberRegistration", fields: [subscriberID], references: [subscriberID])
  plan                         SubscriptionPlan                   @relation("PaymentOrderToSubscriptionPlan", fields: [planID], references: [planID])
  subscription                 Subscription?                      @relation("SubscriptionToPaymentOrder")

  @@index([subscriberID])
  @@index([status])
  @@map("tblPaymentOrder")
}

/// What a successful payment actually buys. Also new.
model Subscription {
  subscriptionID               BigInt                             @id @default(autoincrement()) @map("SubscriptionID")
  subscriberID                 BigInt                             @map("SubscriberID")
  planID                       Int                                @map("PlanID")
  /// One subscription row per paid order — this is what makes activation idempotent.
  orderID                      BigInt                             @unique @map("OrderID")
  startsAt                     DateTime @db.Timestamp(6)          @map("StartsAt")
  endsAt                       DateTime @db.Timestamp(6)          @map("EndsAt")
  createdAt                    DateTime @db.Timestamp(6)          @default(now()) @map("CreatedAt")

  subscriber                   SubscriberRegistration             @relation("SubscriptionToSubscriberRegistration", fields: [subscriberID], references: [subscriberID])
  plan                         SubscriptionPlan                   @relation("SubscriptionToSubscriptionPlan", fields: [planID], references: [planID])
  order                        PaymentOrder                       @relation("SubscriptionToPaymentOrder", fields: [orderID], references: [orderID])

  @@index([subscriberID])
  @@map("tblSubscription")
}

// ---------------------------------------------------------------------------
