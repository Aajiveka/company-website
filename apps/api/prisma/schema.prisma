  skillID                      Int?                               @map("SkillID")  // FK -> MstrSkills (confirmed)
  subFunctionID                Int?                               @map("SubFunctionID")  // FK -> MstrSubFunctions (confirmed)
  totalExp                     Int?                               @map("TotalExp")
  currentCTC                   Decimal? @db.Decimal(18, 0)        @map("CurrentCTC")
  currentCityID                Int?                               @map("CurrentCityID")  // FK -> MstrCily (confirmed)
  flgReadyToRelocate           Int? @db.SmallInt                  @map("flgReadyToRelocate")
  noticePeriod                 Int? @db.SmallInt                  @map("NoticePeriod")
  photoName                    String? @db.VarChar(500)           @map("PhotoName")
  cVPath                       String? @db.VarChar(2000)          @map("CVPath")
  industryTypeID               Int?                               @map("IndustryTypeID")  // FK -> MstrIndustryType (confirmed)
  strTag                       String? @db.VarChar(500)           @map("strTag")

  city                         MstrCily?                          @relation("SubscriberCVDetails_CityID_To_MstrCily", fields: [cityID], references: [cityID])
  currentCity                  MstrCily?                          @relation("SubscriberCVDetails_CurrentCityID_To_MstrCily", fields: [currentCityID], references: [cityID])
  industryType                 MstrIndustryType?                  @relation("SubscriberCVDetailsToMstrIndustryType", fields: [industryTypeID], references: [industryTypeID])
  skill                        MstrSkills?                        @relation("SubscriberCVDetailsToMstrSkills", fields: [skillID], references: [skillID])
  subFunction                  MstrSubFunctions?                  @relation("SubscriberCVDetailsToMstrSubFunctions", fields: [subFunctionID], references: [subFunctionID])
  subscriber                   SubscriberRegistration             @relation("SubscriberCVDetailsToSubscriberRegistration", fields: [subscriberID], references: [subscriberID])
  @@index([skillID])
  @@index([currentCityID])
  @@index([industryTypeID])
  /// Registration checks this column on every signup. Non-unique on purpose: the column is
  /// nullable and inherited from the legacy import, so a UNIQUE constraint could fail to
  /// apply against existing rows. Uniqueness of *verified* addresses is enforced in
