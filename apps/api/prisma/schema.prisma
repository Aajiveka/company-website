model SecUser {
  userID                       BigInt                             @id @default(autoincrement()) @map("UserID")
  /// POLYMORPHIC — it cannot carry a foreign key.
  ///   role Subscriber  -> NodeID is a tblSubscriberRegistration.SubscriberID
  ///   every other role -> NodeID is a tblMstrPerson.PersonNodeID
  /// tblPMstNodeTypes is the discriminator (100 = "Subscriber"). spSubscriberRegistration
  /// writes NodeID = @SubscriberID; spClientGetCompanyInfo joins NodeID = PersonNodeID.
  /// The data cannot tell them apart — ids 1, 2 and 3 exist in BOTH tables — so an orphan
  /// check "confirmed" a relation that is only true for some rows. Resolve it by role, and
  /// use the explicit SubscriberID column below rather than reading NodeID directly.
  nodeID                       BigInt?                            @map("NodeID")
  nodeType                     Int?                               @map("NodeType")
  userName                     String? @db.VarChar(50)            @map("UserName")
  password                     String? @db.VarChar(255)           @map("Password")
  pwdStatus                    Int?                               @map("PwdStatus")
  active                       String? @db.Char(1)                @map("Active")
  loginType                    Int? @db.SmallInt                  @map("LoginType")
  roleID                       Int?                               @map("RoleID")
  userMail                     String? @db.VarChar(100)           @map("UserMail")

  ClientMstr                   ClientMstr[]                       @relation("ClientMstrToSecUser")
  SecMapUserRoles              SecMapUserRoles[]                  @relation("SecMapUserRolesToSecUser")
  SecUserLogin                 SecUserLogin[]                     @relation("SecUserLoginToSecUser")
  SubscriberStatusHistory      SubscriberStatusHistory[]          @relation("SubscriberStatusHistoryToSecUser")
  /// The candidate profile this login owns. NEW COLUMN — the legacy schema has no link at
  /// all between tblSecUser and tblSubscriberRegistration, and the C# that knew the mapping
  /// (it put SubscriberID straight into Session) was not recovered. /candidates/me happened
  /// to work only because UserID 1 and SubscriberID 1 collided in the dev data; they are
  /// independent identity sequences and would diverge immediately.
  subscriberID                 BigInt?                            @unique @map("SubscriberID")
  subscriber                   SubscriberRegistration?            @relation("SecUserToSubscriberRegistration", fields: [subscriberID], references: [subscriberID])

  AuthPasswordReset            AuthPasswordReset[]                @relation("AuthPasswordResetToSecUser")
  @@index([userName])
  @@index([active])
  @@map("tblSecUser")
}

